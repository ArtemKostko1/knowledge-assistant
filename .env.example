
# ============================================================
# Knowledge Assistant — Local Development Environment
# ============================================================
#
# Copy this file to .env and configure local credentials.
# Commit .env.example, but NEVER commit .env or real secrets.
#
# Local infrastructure:
# - Next.js:      http://127.0.0.1:3000
# - NestJS:       http://127.0.0.1:3001
# - Supabase API: http://127.0.0.1:54321
# - PostgreSQL:   127.0.0.1:54322
# - Mailpit:      http://127.0.0.1:54324
#
# Supabase CLI:
# pnpm exec supabase start
# pnpm exec supabase status -o env
#
# ============================================================
# Application Ports
# ============================================================

CLIENT_PORT=3000
API_PORT=3001
PORT=3001

# ============================================================
# PostgreSQL — Local Host
# ============================================================
#
# Used by processes running directly on Windows.
# Verify credentials using the local Supabase CLI.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ============================================================
# PostgreSQL — Docker Containers
# ============================================================
#
# Docker containers must use host.docker.internal instead
# of 127.0.0.1 to access the Supabase CLI PostgreSQL.
#
# Used by the api and worker Compose services.

COMPOSE_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# ============================================================
# Supabase — Local Host
# ============================================================
#
# Used by processes running directly on Windows.

SUPABASE_URL=http://127.0.0.1:54321

# Public anon key from:
# pnpm exec supabase status -o env
#
# Never replace this with the service_role key.

SUPABASE_ANON_KEY=replace-with-local-anon-key

# Optional privileged key for explicitly approved server tasks.
# NEVER use this key in browser code or NEXT_PUBLIC_*.

SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Supabase — Docker Internal Network
# ============================================================
#
# Used by api and server-side Next.js requests in Docker.
# The Compose file passes this value to SUPABASE_INTERNAL_URL
# inside the client container.

COMPOSE_SUPABASE_URL=http://host.docker.internal:54321

# ============================================================
# Supabase JWT Verification
# ============================================================
#
# The issuer must match the "iss" claim in the actual JWT.
# Do not replace it with host.docker.internal.

SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=ES256

# ============================================================
# Next.js — Public Browser Configuration
# ============================================================
#
# NEXT_PUBLIC_* values are embedded into the client bundle
# at build time. Never place secrets in these variables.
#
# Keep these URLs consistent with supabase/config.toml.

NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Must match SUPABASE_ANON_KEY for the local project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# ============================================================
# AI / LLM
# ============================================================
#
# AI provider keys are intentionally omitted.
# No live AI calls are required for authentication.
