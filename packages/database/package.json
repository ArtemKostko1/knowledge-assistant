{
  "name": "@knowledge-assistant/database",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@knowledge-assistant/config-eslint": "workspace:*",
    "@knowledge-assistant/config-typescript": "workspace:*",
    "@types/node": "24.10.15",
    "@types/pg": "8.15.5",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts"
  }
}
