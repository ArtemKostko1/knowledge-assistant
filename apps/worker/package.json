{
  "name": "@knowledge-assistant/worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@knowledge-assistant/backend": "workspace:*",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@knowledge-assistant/config-eslint": "workspace:*",
    "@knowledge-assistant/config-typescript": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.15",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
