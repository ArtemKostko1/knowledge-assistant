# Copy to .env for local development. Never commit credentials.
# Supabase CLI defaults; check `pnpm exec supabase status` after startup.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional Compose override: use host.docker.internal, never 127.0.0.1 inside containers.
# COMPOSE_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001
# AI keys intentionally absent; no live API calls in bootstrap.
