{
  "name": "knowledge-assistant",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "pnpm --filter @knowledge-assistant/database db:validate",
    "db:migrate": "pnpm --filter @knowledge-assistant/database db:migrate",
    "supabase:start": "supabase start --exclude realtime,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "supabase stop"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
